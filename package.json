{
  "name": "khachsan-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Hotel/motel management desktop app built with Electron, React, Vite, and Tailwind CSS.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "test": "node --test",
    "preview": "vite preview",
    "electron:dev": "npm run dev",
    "electron:build": "npm run build && electron-builder",
    "lint": "echo \"Add ESLint when ready\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.46.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.khachsan.desktop",
    "productName": "KhachSan",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
